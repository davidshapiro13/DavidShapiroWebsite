{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david-shirt-shop",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://davidsshapiro.com",
    "CHECKOUT_ENABLED": "false",
    "FULFILLMENT_ENABLED": "false",
    "PAYMENT_MODE": "test",
    "PRINTIFY_SHOP_ID": "28189423",
    "PRINTIFY_PRODUCT_ID": "6a4fe213435f537ab70d3111",
    "RETAIL_PRICE_CENTS": "2000",
    "SHIPPING_COUNTRIES": "US",
    "SHIPPING_CENTS": "495",
    "STRIPE_TAX_CODE": "txcd_30011000",
    "AUTOMATIC_TAX": "true",
    "PRODUCT_DESCRIPTION": "A reading rabbit, a good book, and a very full schedule. This heavyweight, garment-dyed cotton tee features “My Day Is Fully Booked.”\n\nRelaxed fit · 100% ring-spun cotton · Sizes S–4XL\n\nMachine wash cold. Do not bleach. Tumble dry on low."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shop-orders",
      "database_id": "558ecbfa-a11d-4d93-8a3d-5f6d978cd05d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "account_id": "26b838453ec90d3eefa396fc6ae6d8e8"
}
